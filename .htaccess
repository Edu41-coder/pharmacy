# Redirection de toutes les requêtes vers le dossier public
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Protection des fichiers sensibles
<FilesMatch "^(.env|composer.json|composer.lock)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Protection des dossiers sensibles
<DirectoryMatch "^/.*(app|config|resources|routes|vendor)/.*$">
    Order Deny,Allow
    Deny from all
</DirectoryMatch>