{% extends 'base.html.twig' %}

{% block title %}Méthode non autorisée{% endblock %}

{% block body %}
<div class="error-container text-center">
    <div class="error-code">405</div>
    <h1 class="mb-4">Méthode non autorisée</h1>
    <p class="mb-4">La méthode utilisée n'est pas autorisée pour cette ressource.</p>
    <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
        <i class="fas fa-home me-2"></i>Retour à l'accueil
    </a>
</div>
{% endblock %} 