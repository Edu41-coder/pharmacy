{% extends 'base.html.twig' %}

{% block title %}Erreur serveur{% endblock %}

{% block body %}
<div class="error-container text-center">
    <div class="error-code">500</div>
    <h1 class="mb-4">Erreur serveur</h1>
    <p class="mb-4">Une erreur interne s'est produite sur le serveur. Notre équipe a été notifiée.</p>
    <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
        <i class="fas fa-home me-2"></i>Réessayer plus tard
    </a>
</div>
{% endblock %} 